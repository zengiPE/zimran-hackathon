CORS_ORIGINS=http://localhost:3000
# OpenAI: clue narration + AI teammates' lines (empty = template texts, the game still works)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Reasoning effort for gpt-5 / o-series models ("minimal" = fast). Ignored for gpt-4.1, gpt-4o etc.
OPENAI_REASONING_EFFORT=minimal

# Local default is a SQLite file; on Vercel use Postgres (Neon/Supabase connection string)
DATABASE_URL=sqlite:///./casefile.db

# Stripe TEST mode only (dashboard.stripe.com -> Developers -> API keys, "Test mode" on)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret on Vercel
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Checkout returns the player (the web app)
PUBLIC_WEB_URL=http://localhost:3000

# AI teammates for solo games (true/false); delay multiplier for their "typing" (1 = 2-6 s)
AI_FRIENDS_ENABLED=true
AI_DELAY_SCALE=1
